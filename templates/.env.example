# --- Required secrets ---------------------------------------------------
# Generate: openssl rand -hex 16  (password)
#           openssl rand -hex 32  (encryption key)
# NEVER reuse demo values. Back up N8N_ENCRYPTION_KEY OFF-host (password
# manager); losing it makes every stored credential unreadable forever.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
N8N_ENCRYPTION_KEY=change-me

# --- Version ------------------------------------------------------------
# Production: pin to the current stable tag from
# https://github.com/n8n-io/n8n/releases (e.g. N8N_VERSION=1.x.y).
# Local experiments may keep latest.
N8N_VERSION=latest

# --- Network ------------------------------------------------------------
# 127.0.0.1 = this machine only (also correct for Tailscale Serve).
# 0.0.0.0   = LAN access; only on a trusted network, see skill Safety Rules.
N8N_BIND=127.0.0.1
N8N_PORT=5678

# --- Locale -------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Seoul

# --- Execution history pruning ------------------------------------------
# Hours to keep finished executions (168 = 7 days) and hard cap on rows.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# --- Remote access (Tailscale) — set when enabling Serve/Funnel ----------
#N8N_HOST=machine.tailnet.ts.net
#WEBHOOK_URL=https://machine.tailnet.ts.net/

# --- LAN over plain HTTP — set when access mode is LAN -------------------
#WEBHOOK_URL=http://192.168.x.x:5678/
